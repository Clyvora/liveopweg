{
  "name": "mobilityradar-nl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:realtime": "npm --prefix ../ClyvoraAPI/services/liveopweg run dev --",
    "start:realtime": "npm --prefix ../ClyvoraAPI/services/liveopweg run start:realtime --",
    "dev:phase1": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase2": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase4": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase5": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase6": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase7": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase8": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase9": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase10": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase11": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "ingest:once": "npm --prefix ../ClyvoraAPI/services/liveopweg run ingest:once --",
    "benchmark:decode": "npm --prefix ../ClyvoraAPI/services/liveopweg run benchmark:decode --",
    "benchmark:journey-decode": "npm --prefix ../ClyvoraAPI/services/liveopweg run benchmark:journey-decode --",
    "journey:find-live-candidate": "npm --prefix ../ClyvoraAPI/services/liveopweg run journey:find-live-candidate --",
    "rail:import-geometry": "npm --prefix ../ClyvoraAPI/services/liveopweg run rail:import-geometry --",
    "rail:audit-graph": "npm --prefix ../ClyvoraAPI/services/liveopweg run rail:audit-graph --",
    "rail:measure-match-quality": "npm --prefix ../ClyvoraAPI/services/liveopweg run rail:measure-match-quality --",
    "station3d:build-utrecht": "npm --prefix ../ClyvoraAPI/services/liveopweg run station3d:build-utrecht --",
    "station3d:build": "npm --prefix ../ClyvoraAPI/services/liveopweg run station3d:build --",
    "station3d:validate-source": "npm --prefix ../ClyvoraAPI/services/liveopweg run station3d:validate-source --",
    "benchmark:station3d": "npm --prefix ../ClyvoraAPI/services/liveopweg run benchmark:station3d --",
    "benchmark:track-match": "npm --prefix ../ClyvoraAPI/services/liveopweg run benchmark:track-match --",
    "benchmark:road-decode": "npm --prefix ../ClyvoraAPI/services/liveopweg run benchmark:road-decode --",
    "benchmark:replay": "npm --prefix ../ClyvoraAPI/services/liveopweg run benchmark:replay --",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern var --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate-postgis": "npm --prefix ../ClyvoraAPI/services/liveopweg run db:migrate-postgis --"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "3d-tiles-renderer": "^0.5.1",
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "^6.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "three": "^0.185.1",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
