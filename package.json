{
  "name": "mobilityradar-nl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:realtime": "tsx watch workers/rail-ingestion/server.ts",
    "dev:phase1": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase2": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase4": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase5": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase6": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase7": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase8": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase9": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "dev:phase10": "concurrently -k -n WEB,REALTIME -c cyan,green \"npm:dev\" \"npm:dev:realtime\"",
    "ingest:once": "tsx workers/rail-ingestion/capture-once.ts",
    "benchmark:decode": "tsx workers/rail-ingestion/benchmark-decode.ts",
    "benchmark:journey-decode": "tsx workers/journey-ingestion/benchmark-decode.ts",
    "journey:find-live-candidate": "tsx workers/journey-ingestion/find-live-candidate.ts",
    "rail:import-geometry": "tsx workers/rail-geometry/import-pdok.ts",
    "rail:audit-graph": "tsx workers/rail-geometry/audit-graph.ts",
    "rail:measure-match-quality": "tsx workers/rail-matching/quality-report.ts",
    "station3d:build-utrecht": "tsx workers/station-3d/build-utrecht-bundle.ts",
    "station3d:build": "tsx workers/station-3d/build-station-bundles.ts",
    "station3d:validate-source": "tsx workers/station-3d/validate-pdok3d.ts",
    "benchmark:station3d": "tsx workers/station-3d/benchmark.ts",
    "benchmark:track-match": "tsx workers/rail-matching/benchmark.ts",
    "benchmark:road-decode": "tsx workers/road-ingestion/benchmark.ts",
    "benchmark:replay": "tsx workers/replay/benchmark.ts",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern var --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.1",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "^5.11.0",
    "maplibre-gl": "^6.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "redis": "^6.2.1",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zeromq": "^6.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
