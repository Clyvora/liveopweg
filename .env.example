# Optioneel: file-backed opslag werkt zonder deze variabelen.
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://mobilityradar:local-development-only@127.0.0.1:5432/mobilityradar
FLEET_RETENTION_SECONDS=300
NEXT_PUBLIC_RENDER_DELAY_MS=12000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Alleen nodig wanneer web en realtime gateway niet op dezelfde host draaien.
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:8081/v1/realtime
NDW_ROAD_URL=https://opendata.ndw.nu/actueel_beeld.xml.gz
# NDW adviseert 60 seconden en minimaal 30 seconden.
NDW_ROAD_POLL_SECONDS=60

# Alleen server-side gebruiken. Nooit als NEXT_PUBLIC_-variabele instellen.
NS_API_KEY=
